  "titre": "Les frigos piratés",
  "sous_titre": "La cyberattaque des supermarchés, nuit du 11 au 12 octobre 2026",
  "description": "Les sources de la vidéo de La mécanique du pire sur les frigos de supermarchés piratés en octobre 2026, passage par passage, avec ce qui reste incertain.",
  "verifie": "15 oct. 2026",
  "mise_a_jour": "25 oct. 2026",
  "avertissement": "Vidéo enregistrée le 15 octobre 2026, l’enquête venait de commencer. Les sources datent de ces jours-là.",
  "image_partage": "frigos-pirates.jpg",
  "image_entete": "frigos-pirates.jpg",
  "image_alt": "Miniature de la vidéo : « Piraté, 50 °C », une vitrine réfrigérée qui chauffe.",
  "titre_rapports": "Les documents de référence",
  "parties": [
    {
      "id": "video",
      "numero": 1,
      "nom": "Les frigos piratés",
      "mise_en_ligne": "17 oct. 2026",
      "youtube": "UvYrIWKKJfo",
      "miniature": "frigos-pirates.jpg",
      "note": "",
      "passages": [
        {
          "t": "00:00",
          "titre": "Lundi matin, les frigos chauffent",
          "items": [
            {
              "texte": "Le lundi 12 octobre au matin, des bacs qui ruissellent, de l’air chaud qui sort des congélateurs.",
              "sources": [
                [
                  "complex"
                ],
                [
                  "cbs"
                ]
              ]
            },
            {
              "texte": "Des frigos réglés pour chauffer, jusqu’à 50 °C, dans des centaines de magasins.",
              "sources": [
                [
                  "macg"
                ],
                [
                  "time"
                ]
              ]
            }
          ]
        },
        {
          "t": "00:37",
          "titre": "Personne n’est entré",
          "items": [
            {
              "texte": "Ni effraction, ni panne de courant, ni rançon : des ordres envoyés à distance à des machines branchées sur internet.",
              "sources": [
                [
                  "thn"
                ],
                [
                  "futura"
                ]
              ]
            }
          ]
        },
        {
          "t": "01:31",
          "titre": "Le chef d’orchestre du froid",
          "items": [
            {
              "texte": "Un boîtier central règle les températures, surveille les sondes et déclenche les alarmes ; dans beaucoup de magasins, il est fabriqué par Danfoss.",
              "sources": [
                [
                  "thn"
                ]
              ]
            }
          ]
        },
        {
          "t": "02:01",
          "titre": "Le dégivrage",
          "items": [
            {
              "texte": "Plusieurs fois par jour, le système fait fondre la glace des échangeurs ; pendant ce temps, les alarmes patientent.",
              "sources": [
                [
                  "time"
                ]
              ]
            }
          ]
        },
        {
          "t": "02:33",
          "titre": "Problème 1 · L’âge",
          "items": [
            {
              "texte": "Surtout d’anciens modèles sans mises à jour : l’AK-SC 355, retiré en 2016, et l’AK-SM 800, en fin de vie depuis mai 2021.",
              "sources": [
                [
                  "thn"
                ],
                [
                  "cbs"
                ]
              ]
            },
            {
              "texte": "Une installation frigorifique reste en place quinze ans ou plus.",
              "sources": [
                [
                  "futura"
                ]
              ]
            }
          ]
        },
        {
          "t": "03:05",
          "titre": "Problème 2 · Internet",
          "items": [
            {
              "texte": "Des boîtiers reliés à internet pour la maintenance à distance ; exposer leur page d’administration est « contraire aux bonnes pratiques », selon le CERT-FR.",
              "sources": [
                [
                  "time"
                ]
              ]
            },
            {
              "texte": "Plus de 2 700 systèmes Danfoss visibles en ligne le 12 octobre, près de six sur dix en France.",
              "sources": [
                [
                  "toms"
                ],
                [
                  "complex"
                ]
              ]
            }
          ]
        },
        {
          "t": "03:46",
          "titre": "Problème 3 · Les failles",
          "items": [
            {
              "texte": "Août 2026 : Claroty publie des failles de l’AK-SM 800A, dont un « code du jour » calculé à partir de la date ; Danfoss les avait corrigées en 2025.",
              "sources": [
                [
                  "claroty",
                  "9 août 2026"
                ]
              ]
            },
            {
              "texte": "Selon Danfoss, même les modèles récents touchés tournaient avec un logiciel dépassé.",
              "sources": [
                [
                  "thn"
                ]
              ]
            }
          ],
          "nuances": [
            "Aucun lien n’est établi entre ces failles et l’attaque : ni les enquêteurs ni Danfoss ne l’ont fait."
          ]
        },
        {
          "t": "04:32",
          "titre": "Problème 4 · Les précédents",
          "items": [
            {
              "texte": "En 2022, seize supermarchés russes et quarante magasins israéliens visés ; Danfoss le racontait à ses clients dans sa lettre d’octobre 2025.",
              "sources": [
                [
                  "danfoss",
                  "oct. 2025"
                ]
              ]
            }
          ]
        },
        {
          "t": "05:04",
          "titre": "La nuit du 11 au 12 octobre",
          "items": [
            {
              "texte": "Un dégivrage qui ne s’arrête pas, avec une consigne à 50 °C.",
              "sources": [
                [
                  "macg"
                ],
                [
                  "time"
                ]
              ]
            },
            {
              "texte": "Selon Le Monde, un dégivrage allongé d’une heure à huit heures dans certains congélateurs, pour retarder les alarmes.",
              "sources": [
                [
                  "time"
                ]
              ]
            },
            {
              "texte": "Chez Intermarché, environ 150 magasins restés à 50 °C pendant six heures avant que quiconque s’en aperçoive.",
              "sources": [
                [
                  "complex"
                ],
                [
                  "secweek"
                ]
              ]
            }
          ]
        },
        {
          "t": "05:51",
          "titre": "Au matin, les dégâts",
          "items": [
            {
              "texte": "À La Haye, en Normandie, 80 °C et du matériel fondu ; des départs de feu selon le parquet de Paris.",
              "sources": [
                [
                  "time"
                ],
                [
                  "cbs"
                ]
              ]
            },
            {
              "texte": "À Haguenau, 270 000 € de pertes pour deux magasins ; « plusieurs dizaines de millions d’euros » selon le patron d’Intermarché ; des assurances qui ne couvriraient pas forcément.",
              "sources": [
                [
                  "macg"
                ],
                [
                  "aljazeera"
                ]
              ]
            }
          ]
        },
        {
          "t": "06:28",
          "titre": "700 supermarchés",
          "items": [
            {
              "texte": "Intermarché et Netto, les magasins U (80 touchés, la plupart ont arrêté l’attaque à temps), Carrefour, Monoprix, quelques Leclerc.",
              "sources": [
                [
                  "thn"
                ],
                [
                  "secweek"
                ]
              ]
            },
            {
              "texte": "Premiers décomptes de 300 à 400 magasins, puis environ 700 sur 10 000 selon le ministre de l’Économie ; « au cœur de notre sécurité alimentaire ».",
              "sources": [
                [
                  "complex"
                ],
                [
                  "cedar"
                ]
              ]
            },
            {
              "texte": "Des cas signalés dans cinq autres pays d’Europe, sans confirmation.",
              "sources": [
                [
                  "aljazeera"
                ]
              ]
            },
            {
              "texte": "La nuit suivante, un Leclerc du Tarn équipé de boîtiers Dixell ; l’ANSSI prévient que les attaques sont « probablement toujours en cours ».",
              "sources": [
                [
                  "toms"
                ]
              ]
            }
          ]
        },
        {
          "t": "07:20",
          "titre": "Qui, et pourquoi ?",
          "items": [
            {
              "texte": "Aucune revendication, aucune rançon, aucune donnée volée ; un État « ne peut être exclu », mais rien ne l’indique.",
              "sources": [
                [
                  "futura"
                ],
                [
                  "bluewin"
                ]
              ]
            },
            {
              "texte": "L’enquête confiée à l’Office anticybercriminalité, sous l’autorité du parquet de Paris ; l’ANSSI demande de débrancher ces boîtiers d’internet.",
              "sources": [
                [
                  "thn"
                ],
                [
                  "toms"
                ]
              ]
            }
          ]
        },
        {
          "t": "08:02",
          "titre": "Tout s’est aligné",
          "items": [
            {
              "texte": "Le lendemain de l’attaque, des milliers de pages de contrôle Danfoss encore visibles sur internet.",
              "sources": [
                [
                  "complex"
                ],
                [
                  "toms"
                ]
              ]
            }
          ]
        }
      ]
    }
