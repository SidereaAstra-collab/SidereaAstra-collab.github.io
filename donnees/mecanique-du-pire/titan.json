  "titre": "Titan",
  "sous_titre": "Le sous-marin d’OceanGate, 18 juin 2023",
  "description": "Les sources des deux vidéos de La mécanique du pire sur le Titan, passage par passage : enquêtes officielles, presse, témoignages et points incertains.",
  "verifie": "23 oct. 2026",
  "mise_a_jour": "25 oct. 2026",
  "image_partage": "titan-partage.jpg",
  "illustration": "barrieres",
  "parties": [
    {
      "id": "partie-1",
      "numero": 1,
      "nom": "Construire le Titan",
      "mise_en_ligne": "21 oct. 2026",
      "youtube": "Z6IylfUPRuY",
      "miniature": "titan-partie-1.jpg",
      "note": "",
      "passages": [
        { "t": "00:00", "titre": "Le dernier message", "items": [
          { "texte": "« Lâché deux poids » : le dernier message du Titan, à 10 h 47, depuis 3 341 mètres.", "sources": [["uscgRap", "chronologie de la plongée 88"]] }
        ]},
        { "t": "00:32", "titre": "Quatre protections", "items": [
          { "texte": "Une mort jugée « évitable » : la conception, la certification, l’entretien et l’inspection sont en cause.", "sources": [["uscgCP", "5 août 2025"]] }
        ]},
        { "t": "01:02", "titre": "Stockton Rush et OceanGate", "items": [
          { "texte": "OceanGate, son fondateur et le Titan : les repères généraux.", "sources": [["wikiT"]] }
        ]},
        { "t": "01:44", "titre": "Un tube en carbone", "items": [
          { "texte": "Une coque en tube de fibre de carbone de 127 mm, fermée par deux dômes en titane.", "sources": [["wikiT"]] },
          { "texte": "L’université de Washington travaille sur le projet de 2013 à 2017, puis s’oppose à un choix de conception jugé non éprouvé.", "sources": [["krem"]] },
          { "texte": "Des maquettes au tiers cèdent pendant les essais ; OceanGate ajoute des anneaux en titane.", "sources": [["dn"]] }
        ]},
        { "t": "02:45", "titre": "Écouter la coque", "items": [
          { "texte": "Les capteurs qui écoutent la coque, un système breveté par Stockton Rush.", "sources": [["wikiT"]] }
        ]},
        { "t": "03:09", "titre": "Barrière 1 · Le contrôle", "items": [
          { "texte": "Ni classé ni inspecté ; des plongées présentées comme de la recherche, hors des règles des navires à passagers.", "sources": [["uscgRap"]] },
          { "texte": "2019 : sur son site, OceanGate présente ce genre de validation comme l’ennemi de l’innovation rapide.", "sources": [["kunc"]] }
        ]},
        { "t": "04:12", "titre": "La première coque", "items": [
          { "texte": "2018 : les essais aux Bahamas, et la foudre qui frappe le sous-marin.", "sources": [["knkx"]] },
          { "texte": "Printemps 2019 : Karl Stanley entend des craquements et écrit à Stockton Rush le lendemain.", "sources": [["abc7nyKS"]] },
          { "texte": "Un défaut est découvert ; la première coque est retirée du service.", "sources": [["wikiT"]] }
        ]},
        { "t": "04:57", "titre": "La deuxième coque", "items": [
          { "texte": "Les anneaux et les dômes réutilisés ; un essai à 1,09 fois la pression de l’épave, quand les normes demandent 1,25.", "sources": [["dn"]] }
        ]},
        { "t": "05:20", "titre": "Barrière 2 · Les alertes", "items": [
          { "texte": "David Lochridge : le rapport de janvier 2018, le licenciement, la procédure réglée en novembre 2018.", "sources": [["abc7L"]] },
          { "texte": "« Je savais que cette coque céderait », puis « l’arrogance » : son audition devant les enquêteurs.", "sources": [["abc13", "audience du 17 sept. 2024"]] }
        ]},
        { "t": "06:20", "titre": "La lettre, Tony Nissen", "items": [
          { "texte": "La lettre préparée par des spécialistes de la Marine Technology Society, en mars 2018.", "sources": [["kunc"]] },
          { "texte": "Tony Nissen : « je ne monte pas dedans », une pression « à 100 % », un licenciement en 2019.", "sources": [["knkx", "audience du 16 sept. 2024"]] },
          { "texte": "« La sécurité devient du pur gaspillage » : Stockton Rush, en interview.", "sources": [["ishn"]] },
          { "texte": "Une entreprise où la menace du licenciement dissuadait de parler de sécurité.", "sources": [["uscgCP"]] }
        ]},
        { "t": "07:16", "titre": "Les expéditions de 2021 et 2022", "items": [
          { "texte": "70 puis 48 problèmes d’équipement, dont des batteries qui lâchent.", "sources": [["bg24"]] },
          { "texte": "Les audiences de septembre 2024 : pannes et désaccords pendant les expéditions.", "sources": [["nbcla"], ["herald"]] }
        ]},
        { "t": "07:59", "titre": "La plongée 80", "items": [
          { "texte": "15 juillet 2022 : un grand bruit sec, un « événement acoustique majeur », et aucune vérification.", "sources": [["gcapUSCG"]] },
          { "texte": "Les dommages que le NTSB relève après cette plongée.", "sources": [["gcapNTSB"], ["popsci"]] }
        ]}
      ]
    },
    {
      "id": "partie-2",
      "numero": 2,
      "nom": "La dernière plongée",
      "mise_en_ligne": "24 oct. 2026",
      "youtube": "iSEkhsiPy_Y",
      "miniature": "titan-partie-2.jpg",
      "note": "heures du navire (Terre-Neuve)",
      "passages": [
        { "t": "00:00", "titre": "Le 18 juin 2023, au matin", "items": [
          { "texte": "5 h 15, le Polar Prince arrive sur le site ; 7 h 35, un canot emmène l’équipage sur la plateforme.", "sources": [["uscgRap", "chronologie de la plongée 88"]] },
          { "texte": "La chronologie de la plongée et des recherches, jour par jour.", "sources": [["boat"]] }
        ]},
        { "t": "00:29", "titre": "Les cinq personnes à bord", "items": [
          { "texte": "Les cinq personnes à bord.", "sources": [["bg23"]] },
          { "texte": "Suleman Dawood et son Rubik’s Cube, d’après sa mère.", "sources": [["cbsRub"]] }
        ]},
        { "t": "01:07", "titre": "L’embarquement", "items": [
          { "texte": "Pas de sièges, une seule fenêtre : l’intérieur du Titan, raconté par un ancien passager.", "sources": [["abc7nyIn"]] },
          { "texte": "Le dôme avant, boulonné depuis l’extérieur.", "sources": [["wsls", "21 juin 2023"]] }
        ]},
        { "t": "01:32", "titre": "La descente", "items": [
          { "texte": "9 h 14 : le Titan se détache de sa plateforme et descend en chute libre.", "sources": [["uscgRap"]] },
          { "texte": "Un ancien passager : le contact s’était perdu à chacune de ses plongées.", "sources": [["abc7nyIn"]] }
        ]},
        { "t": "01:50", "titre": "Le contact perdu, « tout va bien ici »", "items": [
          { "texte": "Les messages échangés entre 9 h 53 et 10 h 40, montrés pendant les audiences.", "sources": [["abc7news"], ["uscgRap"]] }
        ]},
        { "t": "02:39", "titre": "10 h 47", "items": [
          { "texte": "« Lâché deux poids », à 3 341 mètres, à moins de 500 mètres du fond.", "sources": [["uscgRap"]] }
        ]},
        { "t": "03:03", "titre": "À bord du Polar Prince", "items": [
          { "texte": "Le bruit sourd entendu dans la salle de contrôle, et la question de Wendy Rush.", "sources": [["explo"]] }
        ]},
        { "t": "03:48", "titre": "15 h : rien à la surface", "items": [
          { "texte": "Le Titan devait remonter seul une heure après la perte de contact : « should have surfaced about 1500 ».", "sources": [["ntsbRap", "p. 9-10"]] },
          { "texte": "La procédure d’OceanGate : encore trois heures de recherches en surface avant d’appeler à l’aide.", "sources": [["uscgRap", "§ 4.1.59-4.1.63"]] }
        ]},
        { "t": "04:12", "titre": "L’alerte, plus de huit heures après", "items": [
          { "texte": "L’appel aux secours canadiens, coupé ; l’alerte reçue à Boston vers 19 h 10.", "sources": [["uscgRap", "§ 4.1.64-4.1.65"], ["ntsbRap", "p. 10-11"]] }
        ]},
        { "t": "04:28", "titre": "La première nuit", "items": [
          { "texte": "22 h : un premier avion des garde-côtes décolle de Terre-Neuve.", "sources": [["ntsbRap", "p. 10-11"], ["uscgRap", "§ 4.1.67"]] },
          { "texte": "De l’oxygène de secours pour 96 heures, et un dôme impossible à ouvrir de l’intérieur.", "sources": [["ntsbRap", "p. 9"], ["wsls"]] }
        ]},
        { "t": "04:49", "titre": "Lundi 19 juin", "items": [
          { "texte": "La nouvelle fait le tour du monde ; le brouillard gêne les recherches.", "sources": [["wikiI"], ["uscgUC"]] },
          { "texte": "Un avion canadien largue des bouées qui écoutent sous l’eau.", "sources": [["ntsbRap", "p. 12"]] }
        ]},
        { "t": "05:00", "titre": "Des robots pour 3 800 mètres", "items": [
          { "texte": "D’ordinaire, deux semaines pour amener un robot de grande profondeur ; l’Odysseus arrive par avion militaire.", "sources": [["ntsbRap", "p. 12"]] },
          { "texte": "L’Atalante, à deux jours de route, déroutée avec le robot Victor 6000.", "sources": [["ifremer", "20 juin 2023"]] }
        ]},
        { "t": "05:24", "titre": "Mardi 20 juin", "items": [
          { "texte": "Le Deep Energy et ses robots prévus pour 3 000 mètres ; le second, poussé plus bas, est perdu.", "sources": [["ntsbRap", "p. 12"]] },
          { "texte": "Dans la nuit, des bruits de cognement, à peu près toutes les 30 minutes.", "sources": [["yahoo"], ["cbsBang"]] }
        ]},
        { "t": "05:49", "titre": "Mercredi 21 juin", "items": [
          { "texte": "Les garde-côtes confirment les bruits, sans savoir d’où ils viennent.", "sources": [["cbsBang"]] },
          { "texte": "Une vingtaine d’heures d’oxygène restantes, selon leurs calculs.", "sources": [["gpb"]] },
          { "texte": "Plus de 31 000 km² fouillés au total, plus que la Belgique.", "sources": [["uscgRap", "§ 4.1.67-4.1.72"], ["statbel", "30 689 km²"]] }
        ]},
        { "t": "06:05", "titre": "Sur le Polar Prince", "items": [
          { "texte": "Christine et Alina Dawood, l’attente sur le navire.", "sources": [["gulf", "entretien BBC repris par l’AP"]] },
          { "texte": "Son livre, « Ninety-Six Hours », paru en mai 2026.", "sources": [["newsweek"]] }
        ]},
        { "t": "06:21", "titre": "Jeudi 22 juin", "items": [
          { "texte": "Vers 9 h 40, l’Odysseus trouve la pointe arrière du Titan, puis les deux dômes en titane.", "sources": [["ntsbRap", "p. 12"], ["uscgRap", "§ 4.1.72"]] },
          { "texte": "À environ 500 mètres de la proue du Titanic.", "sources": [["space"]] }
        ]},
        { "t": "06:52", "titre": "L’annonce", "items": [
          { "texte": "« Consistent with the catastrophic loss of the pressure chamber » : le contre-amiral John Mauger, à Boston.", "sources": [["mauger", "22 juin 2023"]] }
        ]},
        { "t": "07:05", "titre": "Ce que l’on apprend ensuite", "items": [
          { "texte": "Dès le dimanche, la marine avait capté un son compatible avec une implosion.", "sources": [["nprNavy"]] },
          { "texte": "Les bruits de cognement : très probablement l’océan, ou les navires de recherche.", "sources": [["cbsBang"]] },
          { "texte": "Les débris remontés en deux fois, fin juin puis en octobre 2023.", "sources": [["usni23"]] }
        ]},
        { "t": "07:54", "titre": "Barrière 3 · La surveillance", "items": [
          { "texte": "« Let’s dive again and see what happens » : les mesures de la plongée 80.", "sources": [["ntsbPage"], ["gcapNTSB"]] },
          { "texte": "Cinq couches de carbone collées, des vides dans la colle, des couches qui se séparent.", "sources": [["ntsbPage"], ["mex"]] }
        ]},
        { "t": "08:29", "titre": "Barrière 4 · L’entretien", "items": [
          { "texte": "Un hiver dehors à Saint-Jean, puis un sous-marin retrouvé à moitié coulé.", "sources": [["herald"], ["bg24"]] },
          { "texte": "Le remorquage de 2023, en pleine mer, derrière le Polar Prince.", "sources": [["ntsbPage"]] }
        ]},
        { "t": "08:49", "titre": "La plongée 88", "items": [
          { "texte": "La coque s’écrase localement, très probablement à l’avant, près de l’anneau en titane.", "sources": [["ntsbRap"], ["gcapNTSB"]] }
        ]},
        { "t": "09:05", "titre": "Les enquêtes", "items": [
          { "texte": "Une mort « évitable », la négligence, et un renvoi vers la justice fédérale s’il avait survécu.", "sources": [["uscgCP"], ["gcapUSCG"]] },
          { "texte": "Avec des secours prévenus et prêts, le Titan aurait été retrouvé plus vite ; l’équipage ne pouvait pas être sauvé.", "sources": [["ntsbRap", "résumé, p. vi-vii"]] }
        ]},
        { "t": "09:39", "titre": "Les recommandations", "items": [
          { "texte": "Le rapport canadien de juin 2026 et ses six recommandations.", "sources": [["tsb"], ["leth"]] },
          { "texte": "Les 17 recommandations de la Garde côtière.", "sources": [["uscgCP"]] }
        ]}
      ]
    }
  ],
