      "note": "",
      "passages": [
        {
          "t": "00:00",
          "titre": "La nuit du 20 avril 2010",
          "items": [
            {
              "texte": "126 personnes à bord ; peu avant 22 h, la boue jaillit, le gaz se répand, deux explosions ; la plateforme coule et le puits reste ouvert 87 jours.",
              "sources": [
                [
                  "joint",
                  "chronologie"
                ],
                [
                  "comm"
                ]
              ]
            },
            {
              "texte": "Dans son propre rapport d’enquête, BP dessine le « fromage suisse » de l’accident, avec huit barrières franchies.",
              "sources": [
                [
                  "bpRap"
                ]
              ]
            }
          ]
        },
        {
          "t": "01:32",
          "titre": "Macondo, un puits difficile",
          "items": [
            {
              "texte": "Un puits d’exploration en retard de plus de cinq semaines, au-dessus de son budget ; plus d’un demi-million de dollars par jour de location de la plateforme.",
              "sources": [
                [
                  "joint",
                  "coûts et retard du puits"
                ]
              ]
            },
            {
              "texte": "BP exploite le puits, Transocean possède la plateforme, Halliburton cimente.",
              "sources": [
                [
                  "comm"
                ]
              ]
            }
          ]
        },
        {
          "t": "02:18",
          "titre": "Barrière 1 · Le ciment",
          "items": [
            {
              "texte": "Vingt et un centreurs recommandés, six posés ; la mesure de la qualité du ciment n’est pas faite, l’équipe chargée de la faire est renvoyée à terre.",
              "sources": [
                [
                  "congres",
                  "14 juin 2010"
                ]
              ]
            },
            {
              "texte": "Un ciment allégé à l’azote, dont des essais laissaient craindre qu’il ne soit pas stable.",
              "sources": [
                [
                  "comm"
                ]
              ]
            }
          ]
        },
        {
          "t": "02:58",
          "titre": "Barrière 2 · Le test",
          "items": [
            {
              "texte": "La pression remonte dans les tiges de forage, l’« effet vessie » sert d’explication, le test est déclaré réussi sans procédure écrite pour l’interpréter.",
              "sources": [
                [
                  "bpRap"
                ],
                [
                  "comm"
                ]
              ]
            }
          ]
        },
        {
          "t": "03:36",
          "titre": "Barrière 3 · La surveillance",
          "items": [
            {
              "texte": "Près de quarante minutes de pressions anormales ; une partie du flux rejetée à la mer en contournant les appareils de mesure.",
              "sources": [
                [
                  "bpRap"
                ],
                [
                  "comm"
                ]
              ]
            },
            {
              "texte": "Le séparateur débordé, le gaz jusqu’aux moteurs, qui l’enflamment très probablement.",
              "sources": [
                [
                  "bpRap"
                ]
              ]
            }
          ]
        },
        {
          "t": "04:22",
          "titre": "Barrière 4 · Le bloc obturateur",
          "items": [
            {
              "texte": "Le tube de forage tordu et décentré, hors de portée des lames, percé au lieu d’être tranché ; erreurs de câblage et batteries défaillantes.",
              "sources": [
                [
                  "csb1",
                  "volume 1"
                ],
                [
                  "workboat"
                ]
              ]
            }
          ]
        },
        {
          "t": "04:58",
          "titre": "L’évacuation",
          "items": [
            {
              "texte": "115 personnes évacuées, dont 17 blessés ; onze morts, jamais retrouvés.",
              "sources": [
                [
                  "joint"
                ],
                [
                  "comm"
                ]
              ]
            }
          ]
        },
        {
          "t": "05:18",
          "titre": "Les 87 jours",
          "items": [
            {
              "texte": "Mille, puis cinq mille barils par jour annoncés ; estimation finale de 53 000 à 62 000.",
              "sources": [
                [
                  "wikiVol"
                ]
              ]
            },
            {
              "texte": "La vidéo de la fuite diffusée en direct à partir du 20 mai, à la demande d’élus du Congrès.",
              "sources": [
                [
                  "markey",
                  "19 mai 2010"
                ]
              ]
            },
            {
              "texte": "BP plaidera coupable d’entrave au Congrès sur le débit.",
              "sources": [
                [
                  "plaidoyer"
                ]
              ]
            }
          ]
        },
        {
          "t": "06:02",
          "titre": "Des plans d’urgence recopiés",
          "items": [
            {
              "texte": "Des morses dans le golfe du Mexique, un expert mort en 2005, le même consultant pour quatre compagnies : l’audition du 15 juin 2010.",
              "sources": [
                [
                  "nprPlans"
                ],
                [
                  "mojo"
                ]
              ]
            },
            {
              "texte": "La dispense d’étude d’impact accordée à Macondo.",
              "sources": [
                [
                  "crs"
                ]
              ]
            }
          ]
        },
        {
          "t": "06:50",
          "titre": "Des outils de 1979",
          "items": [
            {
              "texte": "Ixtoc I, en 1979 : les mêmes méthodes, et un puits de secours pour finir.",
              "sources": [
                [
                  "nprIxtoc"
                ],
                [
                  "noaaIxtoc"
                ]
              ]
            },
            {
              "texte": "Une industrie sans rien de prêt à cette profondeur ; un couvercle conçu pendant la crise.",
              "sources": [
                [
                  "nbc"
                ]
              ]
            }
          ]
        },
        {
          "t": "07:35",
          "titre": "Ce que devient le pétrole",
          "items": [
            {
              "texte": "Des dispersants injectés au fond, une première, puis la demande de l’agence de l’environnement d’en réduire l’usage.",
              "sources": [
                [
                  "tos"
                ],
                [
                  "epa"
                ]
              ]
            },
            {
              "texte": "Des panaches profonds, du méthane consommé par les bactéries, du pétrole qui tombe vers le fond.",
              "sources": [
                [
                  "whoi"
                ],
                [
                  "ecoNeige"
                ]
              ]
            },
            {
              "texte": "Environ 5 % brûlés, à peine 3 % récupérés ; la crainte du Loop Current.",
              "sources": [
                [
                  "pbs"
                ],
                [
                  "natgeo"
                ]
              ]
            },
            {
              "texte": "Plus de trois millions de barils selon la justice.",
              "sources": [
                [
                  "oedigital",
                  "15 janv. 2015"
                ],
                [
                  "jurist"
                ]
              ]
            },
            {
              "texte": "Plus de 2 000 km de côtes souillées ; marais, huîtres, tortues, dauphins, coraux profonds.",
              "sources": [
                [
                  "noaa"
                ]
              ]
            }
          ],
          "prudences": [
            "Le juge a retenu 3,19 millions de barils déversés, moins que l’estimation du gouvernement (4,09 millions) : la vidéo donne le chiffre de la justice."
          ]
        },
        {
          "t": "08:51",
          "titre": "À terre",
          "items": [
            {
              "texte": "Les nouveaux forages en eaux profondes suspendus pour six mois, à partir de fin mai.",
              "sources": [
                [
                  "wikiMor"
                ]
              ]
            },
            {
              "texte": "La pêche interdite sur environ 37 % des eaux fédérales du golfe, début juin.",
              "sources": [
                [
                  "noaaPeche",
                  "2 juin 2010"
                ]
              ]
            },
            {
              "texte": "Vingt milliards de dollars bloqués pour indemniser les victimes, mi-juin.",
              "sources": [
                [
                  "ogj",
                  "16 juin 2010"
                ]
              ]
            },
            {
              "texte": "Plus de symptômes d’asthme chez les personnes qui ont nettoyé.",
              "sources": [
                [
                  "niehs"
                ]
              ]
            }
          ]
        },
        {
          "t": "09:54",
          "titre": "La commission",
          "items": [
            {
              "texte": "BP rejette une partie des fautes sur Transocean et Halliburton.",
              "sources": [
                [
                  "bpRap"
                ]
              ]
            },
            {
              "texte": "Une cause commune, une gestion du risque défaillante ; des décisions qui faisaient gagner du temps et de l’argent ; un incident très proche chez Transocean en mer du Nord.",
              "sources": [
                [
                  "comm"
                ]
              ]
            }
          ]
        },
        {
          "t": "10:18",
          "titre": "La justice",
          "items": [
            {
              "texte": "2012 : BP plaide coupable d’onze homicides involontaires et d’entrave au Congrès, 4 milliards de dollars.",
              "sources": [
                [
                  "plaidoyer"
                ]
              ]
            },
            {
              "texte": "2014 : négligence grave ; responsabilités partagées à 67, 30 et 3 %.",
              "sources": [
                [
                  "mex2014",
                  "4 sept. 2014"
                ]
              ]
            },
            {
              "texte": "Un règlement de 20,8 milliards de dollars, validé en 2016.",
              "sources": [
                [
                  "ecomag"
                ]
              ]
            },
            {
              "texte": "Poursuites contre des personnes abandonnées ou terminées par des acquittements.",
              "sources": [
                [
                  "pgj"
                ]
              ]
            }
          ]
        },
        {
          "t": "10:55",
          "titre": "Ce qui a changé",
          "items": [
            {
              "texte": "Juillet 2010 : quatre compagnies créent une société commune chargée de tenir des couvercles prêts.",
              "sources": [
                [
                  "mwcc"
                ]
              ]
            },
            {
              "texte": "L’agence qui contrôlait la sécurité et encaissait les revenus du pétrole, démantelée en trois.",
              "sources": [
                [
                  "doi"
                ]
              ]
            },
            {
              "texte": "La règle sur les blocs obturateurs : 2016, 2019, 2023, puis des révisions proposées en 2026.",
              "sources": [
                [
                  "eelp"
                ]
              ]
            },
            {
              "texte": "Juillet 2026 : concessions et sécurité de nouveau dans une même administration.",
              "sources": [
                [
                  "mondaq"
                ]
              ]
            }
          ]
        },
        {
          "t": "11:48",
          "titre": "Un dernier détail",
          "items": [
            {
              "texte": "Sept ans sans accident avec arrêt, célébrés à bord le jour même ; Texas City en 2005 ; une sécurité mesurée au nombre de blessés.",
              "sources": [
                [
                  "csbAudience",
                  "24 juill. 2012"
                ],
                [
                  "csb3",
                  "volume 3"
                ]
              ]
            }
          ]
        }
      ]
